# Aplicatie
APP_URL=http://localhost
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Europe/Bucharest

# Baza de date
DB_HOST=localhost
DB_PORT=3306
DB_NAME=acoperisuri_info
DB_USER=root
DB_PASS=

# ═══════════════════════════════════════════════════════════════════
# CONSULTANȚĂ PASSIVE HOUSE (pagina /consultanta-passive-house)
# ═══════════════════════════════════════════════════════════════════

# Emailul unde se trimit aplicațiile de consultanță
CONSULTING_APPLICATION_EMAIL=mircea@bdmsystems.ro

# WhatsApp (buton click-to-chat)
WHATSAPP_NUMBER=+40756034734

# Upload limits pentru documentele de proiect
UPLOAD_MAX_SIZE_MB=15
UPLOAD_MAX_FILES=8

# ═══════════════════════════════════════════════════════════════════
# ANALYTICS (activat la final după colectarea de date de bază)
# ═══════════════════════════════════════════════════════════════════

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Lasă gol până creezi contul GA4 — codul e pregătit, se activează
# automat când e completat
GA4_MEASUREMENT_ID=

# Google Tag Manager Container ID (format: GTM-XXXXXXX)
GTM_CONTAINER_ID=

# ═══════════════════════════════════════════════════════════════════
# EMAIL SMTP (pentru trimiterea automată)
# ═══════════════════════════════════════════════════════════════════

# Dacă folosești un serviciu extern (SendGrid, Mailgun, Amazon SES):
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=consultanta@acoperisuri.info
MAIL_FROM_NAME="BDM Systems Consultanta"

# ═══════════════════════════════════════════════════════════════════
# INTEGRĂRI VIITOARE (opționale, adaugă când e cazul)
# ═══════════════════════════════════════════════════════════════════

# CRM (dacă adaugi HubSpot, Pipedrive, etc.)
# CRM_TYPE=
# CRM_API_KEY=

# Google Calendar (dacă adaugi programare automată)
# GOOGLE_CALENDAR_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=

# Notification push (Telegram / Pushover pentru alertă instant lead)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
